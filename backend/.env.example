LITELLM_API_KEY=
# Generate with: openssl rand -hex 32
ANOMALOG_API_KEY=
LITELLM_MODEL=qwen3.8-flash
LITELLM_BASE_URL=http://llm.etapinc.com/v1
# Optional JSON map of provider names to additional exact trusted model URLs.
MODEL_BASE_URL_ALLOWLIST={}
LITELLM_ENABLE_THINKING=false
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Used only when explicitly overriding the model to Gemini 2.5.
GEMINI_THINKING_BUDGET=0
MAX_ANALYSIS_TOKENS=40000
MAX_CHAT_HISTORY_TOKENS=4000
MAX_LLM_OUTPUT_TOKENS=2048
MASKING_SERVICE_URL=https://pii.etapinc.com
MASKING_SERVICE_API_KEY=
LIVE_TAIL_MAX_CONCURRENT_SESSIONS=3
LIVE_TAIL_INACTIVITY_TIMEOUT_SECONDS=900
LIVE_TAIL_COST_PER_MINUTE_USD=0.01
LIVE_TAIL_FREE_TIER_MINUTES=1800
AWS_PROFILE=
AWS_REGION=ap-southeast-1
# Optional: assume this role before accessing the centralized monitoring account.
AWS_ROLE_ARN=
# Optional condition value when the monitoring role's trust policy requires it.
AWS_ROLE_EXTERNAL_ID=
AWS_ROLE_SESSION_NAME=anomalog
# In a CloudWatch monitoring account, also list OAM-linked source-account groups.
AWS_INCLUDE_LINKED_ACCOUNTS=false
# Optional comma-separated CloudWatch Logs names or ARNs containing centralized
# CloudTrail events. When set, the CloudTrail tab searches these organization logs.
CLOUDTRAIL_LOG_GROUP_IDENTIFIERS=
CORS_ORIGINS=["http://localhost:5173"]
INBOUND_RATE_LIMIT_PER_MINUTE=120
